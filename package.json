{
  "name": "@skyriver/atlas-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Data-first JavaScript DSL and source-linked renderers for the Skyriver atlases",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/atlas.mjs",
    "./compiler": "./src/compiler.mjs",
    "./store": "./src/store.mjs"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:dom": "node tests/dom.cjs",
    "test:iulr-dom": "node tests/iulr-dom.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:all": "npm test && npm run test:dom && npm run test:iulr-dom",
    "serve": "node tools/serve.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract": "node tools/migration/extract.cjs",
    "update-iulr": "node tools/migration/update-iulr-v9.cjs",
    "build:loader": "node tools/build-loader.mjs",
    "manifest": "node tools/bundle-manifest.mjs",
    "check": "node tools/check.mjs",
    "check:full": "node tools/check.mjs --e2e",
    "index-functions": "node tools/index-functions.mjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@babel/parser": "7.28.4",
    "@babel/traverse": "7.28.4",
    "@playwright/test": "1.56.1",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "prettier": "3.3.3"
  }
}
