{
  "bundleVersion": 1,
  "type": "atlas",
  "id": "iulr",
  "version": "1.0.0",
  "engine": "^1.0.0",
  "kind": "stellar",
  "brand": "Interstellar Union of Liberated Republics",
  "title": "Union of Liberated Republics",
  "atlas": "atlas.json",
  "parts": {
    "shell": "shell.html",
    "styles": [
      "style-0.css"
    ],
    "runtime": [
      {
        "path": "runtime-0.js"
      }
    ]
  },
  "capabilities": {
    "labelThresholdsByLevel": true
  },
  "slots": {
    "downloadName": "IULR-Stellar-Atlas.html",
    "overviewAlias": "union",
    "affiliationLink": "{{brand}}",
    "indexHint": "Try a planet name, TORA designation or stellar class.",
    "orbitalRegister": "UNION REGISTER",
    "localCaptionNote": "Moon and station assignments follow the second-edition survey",
    "localEmptyNote": "No local objects charted.",
    "localMoonNoun": "moon",
    "overviewOptionLabel": "",
    "overviewTitle": "",
    "overviewSubtitle": ""
  },
  "flags": {
    "addressRegionWins": true,
    "architectureFacts": true,
    "bodyRenderOpacity": true,
    "bordersToggleClass": true,
    "closeSidebarOnSelect": true,
    "emptyDossierFactsFallBack": true,
    "fallbackRegion": "avendonraik",
    "focusRegionIgnoresRegion": true,
    "goldenAngleMoonPhase": true,
    "hashIgnoredWithRegion": true,
    "highlightRouteParam": true,
    "highlightedRegionState": true,
    "linkTitleSync": "worlds",
    "minimapRegionPaths": true,
    "minimapViewBox": "0 0 2850 2570",
    "noLocalChartFallback": true,
    "noOverviewRoute": true,
    "planetArticleTitles": true,
    "regionHighlight": true,
    "searchSystemFields": [
      "architecture",
      "cloakStatusText",
      "description"
    ],
    "selectFirstWorld": true,
    "selectKeepsRegion": true,
    "stationLinksUseArticleTitle": true,
    "stationRoute": "focus",
    "titledPlanetInspectLabel": true,
    "visibilityResetsLabels": true,
    "widgetKeepsAddress": true
  }
}
